# Copia este archivo a .env (desarrollo) y a .env.test (pruebas e2e, con la base trazalia_test).
# Los valores coinciden con docker-compose.yml y solo sirven en tu máquina.

NODE_ENV=development
PUERTO=3000

# Rol sin DDL con el que se conecta la aplicación.
DATABASE_URL=postgresql://trazalia_app:app_dev@localhost:5432/trazalia
# Rol propietario de los esquemas; solo lo usa Prisma para migrar.
DATABASE_URL_MIGRACIONES=postgresql://trazalia_migrador:migrador_dev@localhost:5432/trazalia

ORIGEN_WEB=http://localhost:4200
ZONA_HORARIA_NEGOCIO=America/Caracas

# Claves EdDSA (Ed25519) para JWT, DP-11: JWK codificado en base64url, un par para
# access y otro para refresh. Generar un par propio por entorno con:
#   npm run jwt:generar-claves
JWT_ACCESS_CLAVE_PRIVADA=
JWT_ACCESS_CLAVE_PUBLICA=
JWT_REFRESH_CLAVE_PRIVADA=
JWT_REFRESH_CLAVE_PUBLICA=

# Correo saliente (invitaciones). En desarrollo apunta a Mailpit (docker-compose):
# SMTP en 1025, interfaz web en http://localhost:8025, sin usuario/contraseña.
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=Trazalia <no-responder@trazalia.local>
