// Un esquema PostgreSQL por módulo (Documento Cero §3 y §7).
// auditoria_historico no se declara aquí: la aplicación no tiene acceso a él (BR-038).

generator client {
  provider            = "prisma-client"
  output              = "../src/generado/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["acceso", "auditoria", "centros", "historias"]
}

enum Nacionalidad {
  V
  E

  @@schema("acceso")
}

enum RolUsuario {
  ADMINISTRADOR
  FISIOTERAPEUTA

  @@schema("acceso")
}

enum EstadoCuenta {
  PENDIENTE
  ACTIVO
  BLOQUEADO
  SUSPENDIDO
  INACTIVO

  @@schema("acceso")
}

// Spec Módulo A §12. id_usuario (UUID) es la referencia que usan los módulos
// clínicos; no se asigna centro aquí (BR-006).
model Usuario {
  idUsuario          String       @id @default(uuid()) @map("id_usuario")
  nacionalidad       Nacionalidad
  cedula             String
  nombre             String
  apellido           String
  correo             String       @unique
  telefono           String?
  nombreUsuario      String       @unique @map("nombre_usuario")
  hashContrasena     String?      @map("hash_contrasena")
  rol                RolUsuario
  estado             EstadoCuenta @default(PENDIENTE)
  fechaCreacion      DateTime     @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime     @updatedAt @map("fecha_actualizacion")
  fechaActivacion    DateTime?    @map("fecha_activacion")
  ultimoAcceso       DateTime?    @map("ultimo_acceso")
  bloqueadoHasta     DateTime?    @map("bloqueado_hasta")

  invitaciones        InvitacionUsuario[]      @relation("invitacionDestinatario")
  invitacionesCreadas InvitacionUsuario[]      @relation("invitacionCreador")
  sesiones            SesionUsuario[]
  recuperacionesClave RecuperacionContrasena[]

  @@unique([nacionalidad, cedula])
  @@map("usuarios")
  @@schema("acceso")
}

// BR-007/008/031/032. Token de un solo uso; se guarda solo el resumen/hash.
model InvitacionUsuario {
  idInvitacion           String    @id @default(uuid()) @map("id_invitacion")
  idUsuario              String    @map("id_usuario")
  resumenToken           String    @unique @map("resumen_token")
  fechaExpiracion        DateTime  @map("fecha_expiracion")
  fechaConsumo           DateTime? @map("fecha_consumo")
  idAdministradorCreador String?   @map("id_administrador_creador")
  fechaCreacion          DateTime  @default(now()) @map("fecha_creacion")

  usuario              Usuario  @relation("invitacionDestinatario", fields: [idUsuario], references: [idUsuario])
  administradorCreador Usuario? @relation("invitacionCreador", fields: [idAdministradorCreador], references: [idUsuario])

  @@map("invitaciones_usuario")
  @@schema("acceso")
}

// BR-013/014. Token de un solo uso; se guarda solo el resumen/hash. DP-04:
// vencimiento de 15 minutos.
model RecuperacionContrasena {
  idRecuperacion  String    @id @default(uuid()) @map("id_recuperacion")
  idUsuario       String    @map("id_usuario")
  resumenToken    String    @unique @map("resumen_token")
  fechaExpiracion DateTime  @map("fecha_expiracion")
  fechaConsumo    DateTime? @map("fecha_consumo")
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("recuperaciones_contrasena")
  @@schema("acceso")
}

// BR-035. Fallos por identificador normalizado, exista o no la cuenta; no
// referencia a Usuario a propósito (hay que poder contar intentos contra
// identificadores que no corresponden a ninguna cuenta real).
model IntentoAcceso {
  idIntento                String   @id @default(uuid()) @map("id_intento")
  identificadorNormalizado String   @map("identificador_normalizado")
  fechaIntento             DateTime @default(now()) @map("fecha_intento")

  @@index([identificadorNormalizado, fechaIntento])
  @@map("intentos_acceso")
  @@schema("acceso")
}

// Spec §9 y §12. Una fila por sesión/dispositivo (BR-021); control de rotación
// y revocación independiente por sesión.
model SesionUsuario {
  idSesion            String    @id @default(uuid()) @map("id_sesion")
  idUsuario           String    @map("id_usuario")
  etiquetaDispositivo String?   @map("etiqueta_dispositivo")
  resumenJtiRefresh   String    @unique @map("resumen_jti_refresh")
  fechaCreacion       DateTime  @default(now()) @map("fecha_creacion")
  ultimaActividad     DateTime  @default(now()) @map("ultima_actividad")
  fechaExpiracion     DateTime  @map("fecha_expiracion")
  fechaRevocacion     DateTime? @map("fecha_revocacion")
  motivoRevocacion    String?   @map("motivo_revocacion")

  usuario      Usuario                   @relation(fields: [idUsuario], references: [idUsuario])
  renovaciones RegistroTokenRenovacion[]

  @@map("sesiones_usuario")
  @@schema("acceso")
}

// Spec §9.2/7.3. Permite detectar reutilización y revocar la familia de
// refresh tokens de la sesión (AC-017).
model RegistroTokenRenovacion {
  idRegistroToken  String    @id @default(uuid()) @map("id_registro_token")
  idSesion         String    @map("id_sesion")
  resumenJti       String    @unique @map("resumen_jti")
  fechaEmision     DateTime  @default(now()) @map("fecha_emision")
  fechaExpiracion  DateTime  @map("fecha_expiracion")
  fechaConsumo     DateTime? @map("fecha_consumo")
  fechaRevocacion  DateTime? @map("fecha_revocacion")
  reemplazadoPorId String?   @unique @map("reemplazado_por")

  sesion         SesionUsuario            @relation(fields: [idSesion], references: [idSesion])
  reemplazadoPor RegistroTokenRenovacion? @relation("cadenaRenovacion", fields: [reemplazadoPorId], references: [idRegistroToken])
  reemplazaA     RegistroTokenRenovacion? @relation("cadenaRenovacion")

  @@map("registros_token_renovacion")
  @@schema("acceso")
}

// Spec §11. Solo Administradores consultan (Corte 5 añadirá el endpoint);
// traslado semestral a auditoria_historico (BR-038), inaccesible desde la app.
model EventoAuditoria {
  idEvento          String   @id @default(uuid()) @map("id_evento")
  idUsuarioActor    String?  @map("id_usuario_actor")
  idUsuarioAfectado String?  @map("id_usuario_afectado")
  tipoEvento        String   @map("tipo_evento")
  resultado         String
  metadatosMinimos  Json?    @map("metadatos_minimos")
  fechaEvento       DateTime @default(now()) @map("fecha_evento")

  @@map("eventos_auditoria")
  @@schema("auditoria")
}

// ─── Módulo B — Historias clínicas (SPEC B v1.3) ────────────────────────────
// El propietario (id_fisioterapeuta) referencia acceso.usuarios mediante una FK
// declarada en SQL en la migración, sin relación Prisma, para que el código del
// módulo no navegue tablas de otro módulo (Documento Cero §5).

enum TipoHistoria {
  NEURO_ADULTO
  TRAUMA_ADULTO
  REHAB_INFANTIL
  ADULTO_MAYOR

  @@schema("historias")
}

enum EstadoHistoria {
  BORRADOR
  ACTIVA

  @@schema("historias")
}

enum NacionalidadPaciente {
  V
  E

  @@schema("historias")
}

enum SexoPaciente {
  FEMENINO
  MASCULINO

  @@schema("historias")
}

// Corte 6 (SPEC B v1.4 §8.6): dónde atiende el fisioterapeuta en esta historia.
enum ModalidadAtencion {
  DOMICILIO
  CENTRO

  @@schema("historias")
}

enum ParentescoRepresentante {
  MADRE
  PADRE

  @@schema("historias")
}

// SPEC §16 (decisión del 16-11-2026, ver docs/adr): ancla de identidad del
// paciente. No guarda datos personales; cada historia conserva su propia copia.
model Paciente {
  idPaciente       String   @id @default(uuid()) @map("id_paciente")
  idFisioterapeuta String   @map("id_fisioterapeuta")
  fechaCreacion    DateTime @default(now()) @map("fecha_creacion")

  historias HistoriaClinica[]

  // Destino de la FK compuesta de historias: impide que una historia apunte a
  // un paciente de otro fisioterapeuta.
  @@unique([idPaciente, idFisioterapeuta])
  @@index([idFisioterapeuta])
  @@map("pacientes")
  @@schema("historias")
}

// SPEC §5–§13. Los campos que no aplican al tipo quedan nulos. Unicidad de
// duplicados por documento o (infantil sin documento) por nombre+apellido+
// fecha: índices únicos parciales declarados en SQL en la migración.
model HistoriaClinica {
  idHistoria         String                @id @default(uuid()) @map("id_historia")
  idPaciente         String                @map("id_paciente")
  idFisioterapeuta   String                @map("id_fisioterapeuta")
  tipo               TipoHistoria
  estado             EstadoHistoria        @default(BORRADOR)
  archivada          Boolean               @default(false)
  fechaArchivo       DateTime?             @map("fecha_archivo")
  nombre             String
  apellido           String
  nacionalidad       NacionalidadPaciente?
  cedula             String?
  sinDocumento       Boolean               @default(false) @map("sin_documento")
  fechaNacimiento    DateTime?             @map("fecha_nacimiento") @db.Date
  sexo               SexoPaciente?
  dominancia         String?
  ocupacion          String?
  nivelEducativo     String?               @map("nivel_educativo")
  estadoCivil        String?               @map("estado_civil")
  lugarNacimiento    String?               @map("lugar_nacimiento")
  telefono           String?
  correo             String?
  dirEstado          String?               @map("dir_estado")
  dirMunicipio       String?               @map("dir_municipio")
  dirParroquia       String?               @map("dir_parroquia")
  dirComunidad       String?               @map("dir_comunidad")
  contactoNombre     String?               @map("contacto_nombre")
  contactoParentesco String?               @map("contacto_parentesco")
  contactoTelefono   String?               @map("contacto_telefono")
  demandasFisicas    String?               @map("demandas_fisicas")
  fuenteInformacion  String[]              @default([]) @map("fuente_informacion")
  // §8.6/§8.7: modalidad y centro (catálogo compartido, módulo centros; FK en SQL).
  modalidad          ModalidadAtencion?
  idCentro           String?               @map("id_centro")
  fechaCreacion      DateTime              @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime              @updatedAt @map("fecha_actualizacion")

  paciente      Paciente               @relation(fields: [idPaciente, idFisioterapeuta], references: [idPaciente, idFisioterapeuta])
  representante RepresentanteHistoria?

  @@unique([idPaciente, tipo])
  @@index([idFisioterapeuta, archivada, fechaActualizacion])
  @@index([idFisioterapeuta, cedula])
  @@map("historias_clinicas")
  @@schema("historias")
}

// SPEC §8.4: un único representante (madre o padre) por historia infantil.
model RepresentanteHistoria {
  idHistoria       String                   @id @map("id_historia")
  parentesco       ParentescoRepresentante?
  nombre           String?
  apellido         String?
  cedula           String?
  fechaNacimiento  DateTime?                @map("fecha_nacimiento") @db.Date
  estadoCivil      String?                  @map("estado_civil")
  gradoInstruccion String?                  @map("grado_instruccion")
  ocupacion        String?

  historia HistoriaClinica @relation(fields: [idHistoria], references: [idHistoria], onDelete: Cascade)

  @@map("representantes_historia")
  @@schema("historias")
}

// ─── Centros médicos (SPEC B v1.4 §8.7, ADR-0004) ──────────────────────────
// Catálogo COMPARTIDO entre fisioterapeutas de ubicaciones de atención. No es
// un tenant ni dueño de datos clínicos. La aplicación solo puede leer e
// insertar (sin UPDATE/DELETE en esta fase). Duplicados: índice único por
// nombre normalizado + estado + municipio normalizado.
model CentroMedico {
  idCentro                String   @id @default(uuid()) @map("id_centro")
  nombre                  String
  nombreNormalizado       String   @map("nombre_normalizado")
  dirEstado               String   @map("dir_estado")
  dirMunicipio            String   @map("dir_municipio")
  municipioNormalizado    String   @map("municipio_normalizado")
  dirParroquia            String   @map("dir_parroquia")
  dirComunidad            String?  @map("dir_comunidad")
  idFisioterapeutaCreador String   @map("id_fisioterapeuta_creador")
  fechaCreacion           DateTime @default(now()) @map("fecha_creacion")

  @@unique([nombreNormalizado, dirEstado, municipioNormalizado])
  @@index([nombreNormalizado])
  @@map("centros_medicos")
  @@schema("centros")
}
